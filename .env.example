# Copy to .env.local and fill in real values.
# These are never committed — .env.local is gitignored.
#
# This fork is fully offline: Sentry, PostHog, and the auto-updater are
# removed, so no telemetry env vars are needed.

# Lara CLI (https://github.com/translated/lara-cli) — only needed when
# regenerating translations.
LARA_ACCESS_KEY_ID=
LARA_ACCESS_KEY_SECRET=
